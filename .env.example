# Kopiere diese Datei nach ".env" und trage deine Werte ein. ".env" wird nie committet.
PORT=3000

# Anbieter: local | meshy | selfhosted
#  local      = eingebauter Low-Poly-Generator (kein Key nötig, erzeugt einfache Formen)
#  meshy      = echte KI über die Meshy-API (Key nötig)
#  selfhosted = eigener Server mit Open-Source-Modell (siehe README)
TEXT3D_PROVIDER=local

# --- Meshy ---
MESHY_API_KEY=
MESHY_REFINE=true          # true = zweite Stufe mit Texturen (dauert länger, kostet mehr Credits)
TARGET_POLYCOUNT=4000      # Ziel-Dreiecke; Roblox-Limit pro MeshPart: 21.844

# --- Selbst gehostet ---
SELFHOSTED_URL=http://localhost:8000
SELFHOSTED_TOKEN=
